[sub_resource type="Shader" id="blur_shader_code"]
code = "shader_type canvas_item;

uniform float blur_amount : hint_range(0.0, 5.0) = 5.0;
uniform vec4 darken_color : source_color = vec4(0.2, 0.2, 0.2, 1.0);

void fragment() {
    vec2 uv = UV;
    vec4 color = vec4(0.0);
    float samples = 9.0;
    float offset = blur_amount / 1000.0;

    // Simple box blur
    for(float x = -1.0; x <= 1.0; x += 1.0) {
        for(float y = -1.0; y <= 1.0; y += 1.0) {
            color += texture(TEXTURE, uv + vec2(x, y) * offset);
        }
    }

    // Apply blur and darken
    COLOR = (color / samples) * darken_color;
}
"

